{
  "name": "hamac",
  "private": true,
  "version": "0.1.0",
  "description": "Hamac — planifier, suivre et contrôler son épargne retraite (logiciel libre, AGPL-3.0)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:db": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d db",
    "dev": "pnpm --parallel --filter @hamac/server --filter @hamac/ui dev",
    "build": "pnpm --filter @hamac/ui build && pnpm --filter @hamac/server build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "sonar": "vitest run --coverage && sonar-scanner",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit -p tsconfig.json",
    "start": "pnpm --filter @hamac/server start"
  },
  "devDependencies": {
    "@types/node": "24",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
