{
  "name": "@hamac/server",
  "version": "0.3.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Serveur web auto-hébergé de Hamac : comptes utilisateurs, PostgreSQL, un tenant isolé par personne.",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node --env-file-if-exists=../../.env dist/server.mjs\"",
    "build": "tsup && node scripts/copy-ui.mjs",
    "start": "node --env-file-if-exists=../../.env dist/server.mjs",
    "cli": "node dist/cli.mjs"
  },
  "devDependencies": {
    "@hamac/api": "workspace:^",
    "@hamac/backend": "workspace:^",
    "@hamac/core": "workspace:^",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "tsup": "^9.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "hash-wasm": "4.12.0",
    "zod": "^4.6.7"
  }
}
